// Detection idea: agent command execution in sensitive repositories.
BeaconRuntime_CL
| where TimeGenerated > ago(1h)
| where EventAction == "command.executed" or isnotempty(CommandLine)
| where Repository has_any ("production", "infra", "secrets", "security")
| project TimeGenerated, HostName, UserName, HarnessName, SessionId, CommandLine, Repository, Branch, Message

// Detection idea: agent edits to credential-like files. The path filter is the credential
// stores Beacon's threat rules use (rules/concepts/credential-stores.md), generated from the
// same catalog.
BeaconRuntime_CL
| where TimeGenerated > ago(1h)
| where EventAction startswith "file."
| extend FilePath = tostring(RawData.file.path)
| where (FilePath matches regex @"(?i)(?:^|[/\\])(?:\.aws[/\\]credentials$|\.aws[/\\]sso[/\\]cache[/\\]|\.aws[/\\]cli[/\\]cache[/\\]|application_default_credentials\.json$|\.config[/\\]gcloud[/\\](?:credentials|access_tokens)\.db$|\.azure[/\\](?:msal_token_cache|accesstokens)\.json$|id_(?:rsa|ed25519|ecdsa|dsa|ecdsa_sk|ed25519_sk)$|\.env$|\.git-credentials$|\.config[/\\]git[/\\]credentials$|\.config[/\\]gh[/\\]hosts\.yml$|\.npmrc$|\.pypirc$|\.docker[/\\]config\.json$|\.netrc$|\.pgpass$|[^/\\]*\.tfstate$|[^/\\]*\.tfstate\.backup$|\.terraform\.d[/\\]credentials\.tfrc\.json$|credentials$|credentials\.(?:json|toml)$|secrets\.(?:yaml|yml|json)$|\.kube[/\\]config$|\.kube[/\\]config-[^/\\]*$|kubeconfig$|kubeconfig\.(?:yaml|yml)$|\.kube[/\\][^/\\]*kubeconfig[^/\\]*$|(?:sa|kube|kubernetes|k8s|cluster|admin|user|deploy|bootstrap)(?:-|_|)token(?:|\.csv)$|service(?:-|_|)account(?:-|_|)token(?:|\.csv)$|\.kube[/\\](?:[^/\\]+[/\\])*[^/\\]*token[^/\\]*$|var[/\\]run[/\\]secrets[/\\]kubernetes\.io[/\\]serviceaccount[/\\]token$|\.gnupg[/\\]private-keys-v1\.d[/\\]|secring\.gpg$|\.gnupg[/\\]openpgp-revocs\.d[/\\]|\.gnupg[/\\][^/\\]*\.key$|[^/\\]*\.kdbx$|\.password-store[/\\]|(?:\.1password|1Password)[/\\]|\.config[/\\]Bitwarden[/\\]|(?:\.lastpass|LastPass)[/\\]|\.bitwarden[/\\]|\.config[/\\]Bitwarden[^/\\]*\.sqlite$|\.config[/\\]Bitwarden[^/\\]*\.sqlite\.[^/\\]*$|cookies\.sqlite$|logins\.json$|(?:google-chrome|chromium|chrome|brave-browser|brave browser|bravebrowser|bravesoftware|microsoft-edge|microsoft edge|microsoftedge|edge|firefox|mozilla|safari)(?:|-beta| beta|-dev| dev|-canary| canary|-unstable| unstable|-sxs| sxs)[/\\](?:[^/\\]+[/\\])*(?:[^/\\]*cookies|[^/\\]*login data)$)" or (FilePath matches regex @"(?i)(?:^|[/\\])(?:\.ssh[/\\]id_[^/\\]*$)" and not(FilePath matches regex @"(?i)(?:^|[/\\])(?:[^/\\]*\.pub$)")) or (FilePath matches regex @"(?i)(?:^|[/\\])(?:\.env\.[^/\\]*$)" and not(FilePath matches regex @"(?i)(?:^|[/\\])(?:\.env\.(?:example|sample|template|dist)$|\.env\.[^/\\]*\.(?:example|sample|template|dist)$)")))
| project TimeGenerated, HostName, UserName, HarnessName, SessionId, EventAction, FilePath, Repository, Branch
